# ── Runtime ──────────────────────────────────────────────
NODE_ENV=development
PORT=4000
CORS_ORIGIN=http://localhost:5173

# ── Database (Azure PostgreSQL Flexible Server) ──────────
# ONE database backs local development and the deployed API. There is no local
# database: what you change while developing changes production.
#
#   * Never run `prisma migrate dev` against it — it offers to RESET on drift.
#     Author SQL with `npm run prisma:migrate:new`, review it, apply with
#     `npm run prisma:migrate`.
#   * `npm run seed` refuses to run against a remote host; it wipes every table.
#   * Your machine's public IP must be allowed under the server's
#     Networking -> Firewall rules, or connections simply time out.
DATABASE_URL="postgresql://USER:PASSWORD@SERVER.postgres.database.azure.com:5432/egdigital?sslmode=require"

# ── Auth ─────────────────────────────────────────────────
JWT_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d
# Encrypts admin-provisioned client passwords so an admin can reveal them (login
# still uses the argon2 hash). Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CREDENTIAL_ENC_KEY=

# ── Seed / Super Admin (never hardcode in source) ────────
SUPER_ADMIN_EMAIL=admin@egdigital.com.au
SUPER_ADMIN_PASSWORD=ChangeMe!2026
SUPER_ADMIN_FIRST_NAME=EG
SUPER_ADMIN_LAST_NAME=Admin

# ── File storage (local | azure) ─────────────────────────
# Production must use azure: App Service disks are ephemeral and lose uploads
# on restart. The container must allow anonymous blob read, because uploaded
# URLs are persisted on the record and must not expire.
STORAGE_DRIVER=local
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER=eg-digital

# ── Payments (provider-agnostic) ─────────────────────────
PAYMENT_PROVIDER=mock
PAYMENT_SECRET_KEY=
PAYMENT_WEBHOOK_SECRET=
PAYMENT_PUBLIC_BASE_URL=http://localhost:5173

# ── Email ────────────────────────────────────────────────
# 'console' logs emails to the server console (dev only — in PRODUCTION the send
# path now refuses to run on 'console', so an invoice is never marked SENT when
# nothing was emailed). 'smtp' sends through a real mailbox; 'brevo' sends via
# Brevo's HTTP API. A provider that is selected but missing its credentials is
# treated as undeliverable, not silently downgraded.
EMAIL_PROVIDER=console
# Only for EMAIL_PROVIDER=brevo.
EMAIL_API_KEY=
# The visible sender. Use a real mailbox on a domain with SPF + DKIM + DMARC
# (see DEPLOYMENT.md) so mail reaches the inbox instead of spam/junk.
EMAIL_FROM=connect@egdigital.com.au
EMAIL_FROM_NAME=EG Digital
# Optional — where replies land if different from EMAIL_FROM.
EMAIL_REPLY_TO=

# SMTP transport (EMAIL_PROVIDER=smtp).
#
# Microsoft 365 / Outlook — client SMTP submission:
#   SMTP_HOST=smtp.office365.com   (the DNS name, never an IP)
#   SMTP_PORT=587                  (NOT 465 — 465 does not support the TLS
#                                   versions M365 requires; port 25 is blocked
#                                   outbound on Azure App Service anyway)
#   SMTP_SECURE=false              (STARTTLS upgrades the connection on 587)
#   SMTP_USER / SMTP_PASS = the mailbox's own sign-in credentials
#
# The mailbox must be licensed, and "Authenticated SMTP" must be switched on for
# it — Microsoft disables SMTP AUTH by default for tenants created after January
# 2020. It is also incompatible with Entra ID security defaults.
#
# Google Workspace: smtp.gmail.com:587 with an app password.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

APP_URL=http://localhost:5173

# ── ABN lookup (Australian Business Register) ────────────
# Register for a free GUID (one per party) at:
#   https://abr.business.gov.au/Documentation/WebServiceRegistration
# Without ABR_GUID the lookup falls back to parsing the public ABN Lookup
# page — same data, but markup that a site redesign can break. Set the GUID
# and the stable JSON web service takes over automatically.
# Set ABN_LOOKUP_ENABLED=false to turn it off entirely.
ABN_LOOKUP_ENABLED=true
ABR_URL=https://abr.business.gov.au
ABR_GUID=
ABR_USER_AGENT=EG-Digital-SaaS/1.0 (customer ABN autofill)

# ── Locale ───────────────────────────────────────────────
DEFAULT_CURRENCY=AUD
DEFAULT_LOCALE=en-AU

# ── Geocoding (address auto-fill) ────────────────────────
GEOCODING_ENABLED=true
GEOCODER_URL=https://nominatim.openstreetmap.org
GEOCODER_USER_AGENT=EG-Digital-SaaS/1.0 (admin address autofill)
GEOCODER_EMAIL=
# Optional. When set, address forms use Google's Geocoding API instead of
# Nominatim. Enable "Geocoding API" for the key and restrict it by IP in the
# Google Cloud console. The key is used server-side only — never exposed to the browser.
GOOGLE_MAPS_API_KEY=
