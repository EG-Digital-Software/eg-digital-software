{
  "name": "eg-digital-backend",
  "version": "1.0.0",
  "description": "EG Digital SaaS Platform — REST API",
  "type": "module",
  "main": "dist/server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "seed": "tsx prisma/seed.ts",
    "prisma:generate": "prisma generate",
    "_comment_migrate": "One shared Azure database backs local and live. `migrate dev` offers to RESET on drift, so it is not wired to a script. Author SQL with prisma:migrate:new, review it, then apply with prisma:migrate.",
    "prisma:migrate": "prisma migrate deploy",
    "prisma:migrate:new": "prisma migrate dev --create-only",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:studio": "prisma studio",
    "lint": "eslint \"src/**/*.ts\""
  },
  "dependencies": {
    "@azure/storage-blob": "^12.33.0",
    "@prisma/client": "^6.2.1",
    "argon2": "^0.41.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.2.0",
    "node-cron": "^3.0.3",
    "nodemailer": "^9.0.5",
    "papaparse": "^5.4.1",
    "pino": "^9.6.0",
    "pino-http": "^10.4.0",
    "qrcode": "^1.5.4",
    "xlsx": "^0.18.5",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.8",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.10.5",
    "@types/node-cron": "^3.0.11",
    "@types/nodemailer": "^8.0.1",
    "@types/papaparse": "^5.3.15",
    "@types/qrcode": "^1.5.5",
    "eslint": "^9.18.0",
    "globals": "^17.11.0",
    "pino-pretty": "^13.0.0",
    "prisma": "^6.2.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.67.0"
  }
}
