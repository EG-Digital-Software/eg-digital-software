{
  "expo": {
    "name": "EG Eloma",
    "slug": "eg-eloma-tasks",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "egeloma",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "org.elomagroup.egdigital",
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "Choose photos and videos to share in task chats.",
        "NSCameraUsageDescription": "Take photos to share in task chats."
      }
    },
    "android": {
      "package": "org.elomagroup.egdigital",
      "adaptiveIcon": {
        "foregroundImage": "./assets/eg-eloma-mark-light.png",
        "backgroundColor": "#0B1F3A"
      },
      "googleServicesFile": "./google-services.json",
      "permissions": [
        "POST_NOTIFICATIONS",
        "VIBRATE"
      ]
    },
    "plugins": [
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "Choose photos and videos to share in task chats.",
          "cameraPermission": "Take photos to share in task chats."
        }
      ],
      "expo-asset",
      "expo-font",
      "expo-status-bar",
      [
        "expo-splash-screen",
        {
          "image": "./assets/eg-eloma-mark-light.png",
          "resizeMode": "contain",
          "backgroundColor": "#0B1F3A"
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Sign in to EG Eloma with Face ID."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#2DB98A",
          "defaultChannel": "default"
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-sharing",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Fill in a customer address from where you are."
        }
      ]
    ],
    "extra": {
      "apiUrl": "https://eg-digital-api-fcgbfcajbqehgpd5.australiaeast-01.azurewebsites.net/api"
    }
  }
}
