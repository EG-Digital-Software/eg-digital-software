{
  "expo": {
    "name": "EG Eloma",
    "slug": "eg-eloma-tasks",
    "platforms": [
      "android",
      "ios"
    ],
    "owner": "eg-eloma",
    "version": "1.0.0",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0,
      "url": "https://u.expo.dev/aa322b70-2e21-4406-acca-63c6fcad8449"
    },
    "orientation": "portrait",
    "scheme": "egeloma",
    "icon": "./assets/icon-white.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "org.elomagroup.egdigital",
      "config": {
        "usesNonExemptEncryption": false
      },
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "Choose photos and videos to share in task chats.",
        "NSCameraUsageDescription": "Take photos to share in task chats.",
        "UISupportedInterfaceOrientations~ipad": [
          "UIInterfaceOrientationPortrait",
          "UIInterfaceOrientationPortraitUpsideDown",
          "UIInterfaceOrientationLandscapeLeft",
          "UIInterfaceOrientationLandscapeRight"
        ]
      }
    },
    "android": {
      "package": "org.elomagroup.egdigital",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon-white.png",
        "backgroundColor": "#FFFFFF"
      },
      "googleServicesFile": "./google-services.json",
      "permissions": [
        "POST_NOTIFICATIONS",
        "VIBRATE"
      ]
    },
    "plugins": [
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "Choose photos and videos to share in task chats.",
          "cameraPermission": "Take photos to share in task chats."
        }
      ],
      "expo-asset",
      "expo-font",
      "expo-status-bar",
      [
        "expo-splash-screen",
        {
          "image": "./assets/eg-eloma-mark-light.png",
          "resizeMode": "contain",
          "backgroundColor": "#0B1F3A"
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Sign in to EG Eloma with Face ID."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#2DB98A",
          "defaultChannel": "default"
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-sharing",
      "./plugins/withOptionalScreenFeatures",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Fill in a customer address from where you are."
        }
      ]
    ],
    "extra": {
      "apiUrl": "https://eg-digital-api-fcgbfcajbqehgpd5.australiaeast-01.azurewebsites.net/api",
      "eas": {
        "projectId": "aa322b70-2e21-4406-acca-63c6fcad8449"
      }
    }
  }
}
